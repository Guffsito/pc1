              "raw": "{\n  \"equipmentCode\": \"IMP-3D-04\",\n  \"startTime\": \"2026-10-08T10:00:00-05:00\",\n  \"endTime\": \"2026-10-08T12:00:00-05:00\",\n  \"capacity\": 1\n}",
              "options": {
