              "raw": "{\n  \"username\": \"raul.lab\",\n  \"password\": \"LabPass2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.token);",
                  "pm.test('expiresIn es 3600', function () {",
                  "    pm.expect(data.expiresIn).to.eql(3600);",
                  "});"
                ]
              }
            }
